{
    "manifests": {
        "sylius/mollie-plugin": {
            "manifest": {
                "bundles": {
                    "Sylius\\MolliePlugin\\SyliusMolliePlugin": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "add-lines": [
                    {
                        "file": "templates/bundles/SyliusShopBundle/_scripts.html.twig",
                        "content": "<script src=\"https://js.mollie.com/v1/mollie.js\"></script>",
                        "position": "top",
                        "warn_if_missing": true
                    },
                    {
                        "file": "assets/admin/entrypoint.js",
                        "content": "import '../../vendor/sylius/mollie-plugin/assets/admin/entrypoint';",
                        "position": "bottom",
                        "warn_if_missing": true
                    },
                    {
                        "file": "assets/shop/entrypoint.js",
                        "content": "import '../../vendor/sylius/mollie-plugin/assets/shop/entrypoint';",
                        "position": "bottom",
                        "warn_if_missing": true
                    }
                ]
            },
            "files": {
                "config/packages/sylius_mollie.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\ContainerConfigurator;",
                        "",
                        "return static function (ContainerConfigurator $containerConfigurator): void {",
                        "    $containerConfigurator->import('@SyliusMolliePlugin/config/config.yaml');",
                        "};",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/sylius_mollie.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use Symfony\\Component\\Routing\\Loader\\Configurator\\RoutingConfigurator;",
                        "",
                        "return static function (RoutingConfigurator $routingConfigurator): void {",
                        "    $routingConfigurator->import('@SyliusMolliePlugin/config/routes.yaml');",
                        "};",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "5202a0c399f98d8d166b7d1e3762a9c91b954862"
        }
    }
}
