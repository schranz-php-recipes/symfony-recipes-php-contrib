{
    "manifests": {
        "sylius/mollie-plugin": {
            "manifest": {
                "bundles": {
                    "SyliusMolliePlugin\\SyliusMolliePlugin": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "add-lines": [
                    {
                        "file": "assets/admin/entry.js",
                        "content": "import '../../vendor/sylius/mollie-plugin/src/Resources/assets/admin/entry';",
                        "position": "bottom",
                        "warn_if_missing": true
                    },
                    {
                        "file": "assets/shop/entry.js",
                        "content": "import '../../vendor/sylius/mollie-plugin/src/Resources/assets/shop/entry';",
                        "position": "bottom",
                        "warn_if_missing": true
                    }
                ]
            },
            "files": {
                "config/packages/sylius_mollie.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\ContainerConfigurator;",
                        "",
                        "return static function (ContainerConfigurator $containerConfigurator): void {",
                        "    $containerConfigurator->import('@SyliusMolliePlugin/Resources/config/config.yaml');",
                        "};",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/sylius_mollie.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use Symfony\\Component\\Routing\\Loader\\Configurator\\RoutingConfigurator;",
                        "",
                        "return static function (RoutingConfigurator $routingConfigurator): void {",
                        "    $routingConfigurator->import('@SyliusMolliePlugin/Resources/config/routing.yaml');",
                        "};",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "753e5ef1cb3030b74b664e1cad08552b6da1cfb9"
        }
    }
}
